{
  "name": "saliyah-government-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply saliyah-db --local",
    "db:remote": "wrangler d1 migrations apply saliyah-db --remote",
    "test": "python3 tests/integration.py && node tests/http-contract.mjs && node tests/auth-flow.mjs && node tests/permissions.mjs",
    "preflight": "node tests/release-preflight.mjs",
    "smoke": "node tests/staging-smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
